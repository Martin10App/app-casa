rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function legacyMember() {
      return signedIn() && request.auth.token.email in [
        'martinmolina10101@gmail.com',
        'luciia0295@gmail.com',
        'brumitta1608@gmail.com'
      ];
    }

    function householdMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    function householdMemberAfter(householdId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    // Datos históricos de Martín y Lucía: permanecen exactamente donde están.
    match /{legacyCollection}/{document=**} {
      allow read, write: if legacyCollection in ['items', 'prices', 'inventory', 'compras', 'homeCards', 'meta']
        && legacyMember();
    }

    match /accounts/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow read: if householdMember(householdId);
      allow update: if (
        signedIn()
        && resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && get(/databases/$(database)/documents/invites/$(resource.data.inviteId)).data.active == true
      );
      allow delete: if false;

      match /{subCollection}/{document=**} {
        allow read: if householdMember(householdId);
        allow write: if householdMemberAfter(householdId);
      }
    }

    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && householdMemberAfter(request.resource.data.householdId);
      allow update: if signedIn()
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'usedBy', 'usedAt']);
      allow delete: if false;
    }
  }
}
